<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>EVEMon.LogitechG15</RootNamespace>
    <AssemblyName>EVEMon.LogitechG15</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Managed wrapper for the Logitech Gaming LCD SDK; it P/Invokes the native DLLs below. -->
    <Reference Include="LogitechLcd.NET">
      <HintPath>LogitechLcd.NET.dll</HintPath>
    </Reference>
    <None Include="LogitechLcd.x64.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="LogitechLcd.x86.dll" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\LCDSplash.bmp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EVEMon.Common\EVEMon.Common.csproj" />
  </ItemGroup>
</Project>
