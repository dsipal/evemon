<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>EVEMon.Common</RootNamespace>
    <AssemblyName>EVEMon.Common</AssemblyName>
    <!-- Threading\Dispatcher.cs is built on the WPF Dispatcher / DispatcherTimer. -->
    <UseWPF>true</UseWPF>
    <DefineConstants>TRACE;NO_THREAD_SAFETY</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
  </ItemGroup>

  <!-- Files that live in the tree but have never been part of the build. -->
  <ItemGroup>
    <Compile Remove="Attributes\FullKeyAttribute.cs" />
    <Compile Remove="Helpers\BlankCharacterUIHelper.cs" />
    <Compile Remove="IgbService\**" />
    <Compile Remove="Resources\Skill_Select\Group*\*.cs" />
    <Compile Remove="Serialization\Settings\SerializableAccount.cs" />
    <Compile Remove="Serialization\Settings\SerializableResearchPoint.cs" />
    <Compile Remove="SettingsObjects\EveMailMessagesColumn.cs" />
    <Compile Remove="SettingsObjects\EveMailMessagesColumnSettings.cs" />
    <Compile Remove="SettingsObjects\EveMailMessagesSettings.cs" />
    <Compile Remove="SettingsObjects\EveNotificationsColumn.cs" />
    <Compile Remove="SettingsObjects\EveNotificationsColumnSettings.cs" />
    <Compile Remove="SettingsObjects\EveNotificationsSettings.cs" />
    <Compile Remove="SettingsObjects\IgbSettings.cs" />
    <Compile Remove="SettingsObjects\SerializableRectangle.cs" />
    <!-- The skill icon sets ship as loose .resources files instead, see GenerateSkillIconSets. -->
    <EmbeddedResource Remove="Resources\Skill_Select\Group*\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Serialization\Eve\rowsets-transform.xslt" />
    <EmbeddedResource Include="Serialization\Datafiles\datafile-transform.xslt" />
    <EmbeddedResource Include="Serialization\Settings\settings-transform.xslt" />
    <EmbeddedResource Include="Serialization\NotificationRefTypes.xml" />
    <EmbeddedResource Include="Serialization\Flags.xml" />

    <None Update="Resources\*.xml.gzip" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Resources\License\gpl.txt" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.Calendar.v3" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\IO.Swagger\IO.Swagger.csproj" />
  </ItemGroup>

  <!--
    The skill icon sets are loaded at runtime from Resources\Skill_Select\Group*\*.resources
    (see SkillSelectControl / SettingsForm). Build them from their .resx sources in the
    preserialized format, which DeserializingResourceReader reads without BinaryFormatter.
  -->
  <ItemGroup>
    <SkillIconSet Include="Resources\Skill_Select\Group*\*.resx" />
  </ItemGroup>
  <Target Name="GenerateSkillIconSets" DependsOnTargets="ResolveAssemblyReferences"
          Inputs="@(SkillIconSet)" Outputs="@(SkillIconSet->'$(IntermediateOutputPath)%(RelativeDir)%(Filename).resources')">
    <MakeDir Directories="@(SkillIconSet->'$(IntermediateOutputPath)%(RelativeDir)')" />
    <GenerateResource Sources="@(SkillIconSet)"
                      OutputResources="@(SkillIconSet->'$(IntermediateOutputPath)%(RelativeDir)%(Filename).resources')"
                      UsePreserializedResources="true"
                      References="@(ReferencePath)"
                      ExecuteAsTool="false"
                      NeverLockTypeAssemblies="true" />
  </Target>
  <Target Name="CopySkillIconSets" BeforeTargets="AssignTargetPaths" DependsOnTargets="GenerateSkillIconSets">
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)%(SkillIconSet.RelativeDir)%(SkillIconSet.Filename).resources"
            Link="%(SkillIconSet.RelativeDir)%(SkillIconSet.Filename).resources"
            CopyToOutputDirectory="PreserveNewest" />
      <FileWrites Include="$(IntermediateOutputPath)%(SkillIconSet.RelativeDir)%(SkillIconSet.Filename).resources" />
    </ItemGroup>
  </Target>

  <!--
    Release/Snapshot builds stamp SharedAssemblyInfo.cs from SharedAssemblyInfo.template.cs:
    $REVNUM$ becomes the git commit count and $UTCYEAR$ the current UTC year.
  -->
  <Target Name="GenerateSharedAssemblyInfo" BeforeTargets="BeforeBuild" Condition="'$(Configuration)' == 'Release' OR '$(Configuration)' == 'Snapshot'">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitRevisionCount" />
    </Exec>
    <PropertyGroup>
      <_SharedAssemblyInfoTemplate>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\SharedAssemblyInfo.template.cs'))</_SharedAssemblyInfoTemplate>
      <_UtcYear>$([System.DateTime]::UtcNow.ToString('yyyy'))</_UtcYear>
      <_SharedAssemblyInfo>$(_SharedAssemblyInfoTemplate.Replace('$REVNUM$', '$(GitRevisionCount.Trim())').Replace('$UTCYEAR$', '$(_UtcYear)').TrimEnd())</_SharedAssemblyInfo>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildThisFileDirectory)..\..\SharedAssemblyInfo.cs" Lines="$([MSBuild]::Escape($(_SharedAssemblyInfo)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
