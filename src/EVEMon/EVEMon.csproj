<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>EVEMon</RootNamespace>
    <AssemblyName>EVEMon</AssemblyName>
    <!-- The SDK embeds the icon, the manifest and a VERSIONINFO built from SharedAssemblyInfo.cs. -->
    <ApplicationIcon>..\EVEMon.Common\Resources\Icons\EVEMon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Snapshot'">
    <DefineConstants>SNAPSHOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\SharedAssemblyInfo.cs" Link="Properties\SharedAssemblyInfo.cs" />
  </ItemGroup>

  <!-- Files that live in the tree but have never been part of the build. -->
  <ItemGroup>
    <Compile Remove="BlankCharacter\**" />
    <EmbeddedResource Remove="BlankCharacter\**" />
    <Compile Remove="Schedule\**" />
    <EmbeddedResource Remove="Schedule\**" />
    <Compile Remove="SkillPlanner\EveObjectBrowserSimple*.cs" />
    <EmbeddedResource Remove="SkillPlanner\EveObjectBrowserSimple.resx" />
    <Compile Remove="SkillPlanner\SuggestionWindow*.cs" />
    <EmbeddedResource Remove="SkillPlanner\SuggestionWindow.resx" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaces the System.Windows.Forms.DataVisualization (Chart) assembly from .NET Framework. -->
    <PackageReference Include="WinForms.DataVisualization" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EVEMon.Clients.Winforms\EVEMon.Clients.Winforms.csproj" />
    <ProjectReference Include="..\..\IO.Swagger\IO.Swagger.csproj" />
    <ProjectReference Include="..\EVEMon.Common\EVEMon.Common.csproj" />
    <ProjectReference Include="..\EVEMon.LogitechG15\EVEMon.LogitechG15.csproj" />
    <ProjectReference Include="..\EVEMon.PieChart\EVEMon.PieChart.csproj" />
    <ProjectReference Include="..\EVEMon.Watchdog\EVEMon.Watchdog.csproj" />
    <ProjectReference Include="..\EVEMon.WindowsApi\EVEMon.WindowsApi.csproj" />
  </ItemGroup>
</Project>
