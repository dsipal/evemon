<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EVEMon.InstallBuilder</RootNamespace>
    <AssemblyName>EVEMonInstallBuilder</AssemblyName>
    <!-- AssemblyInfo.cs uses a wildcard AssemblyVersion. -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Snapshot'">
    <DefineConstants>SNAPSHOT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <None Update="EVEMonInstallerScript.nsi" CopyToOutputDirectory="Always" />
    <None Update="UAC.nsh" CopyToOutputDirectory="Always" />
    <!-- The bundled NSIS compiler is run from the project directory. -->
    <None Remove="NSIS\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpZipLib" />
  </ItemGroup>
</Project>
